# Copy this file to .env and fill in what you have. Everything is optional: the app falls back safely.
DEMO_MODE=1
DATA_BACKEND=demo
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TZ_NAME=Asia/Kolkata
ANTHROPIC_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
DEMO_FAMILY_WHATSAPP=whatsapp:+91XXXXXXXXXX
DEMO_NURSE_WHATSAPP=whatsapp:+91XXXXXXXXXX
SARVAM_API_KEY=
# Voice (Sarvam AI) - see docs/VOICE.md. Only SARVAM_API_KEY is needed; the rest have good defaults.
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=
VOICE_GENDER=female
SARVAM_TTS_PACE=0.9
SARVAM_TTS_CODEC=mp3
SARVAM_STT_MODEL=saaras:v4
SARVAM_TRANSLATE_MODEL=mayura:v1
SARVAM_TIMEOUT_S=25
# Public address of this server (e.g. https://spirobuddy.onrender.com) so WhatsApp/Twilio can fetch voice notes
PUBLIC_BASE_URL=
PORT=8000

# ---- Comms: calls, WhatsApp, escalation ladder (docs/COMMS.md). All optional: without them
# ---- calls ring in the browser phone simulator and WhatsApp is a dry run.
# Which call provider: auto | twilio | exotel | sarvam_agent | dry_run
CALL_PROVIDER=auto
# Twilio Voice (demo only: calls to India show an international caller ID)
TWILIO_VOICE_FROM=
# Optional Twilio quick-reply templates (Content API SIDs) and messaging service
TWILIO_CONTENT_SID_REMINDER=
TWILIO_CONTENT_SID_GUARDIAN=
TWILIO_MESSAGING_SERVICE_SID=
# Check Twilio webhook signatures when PUBLIC_BASE_URL is set (1/0)
TWILIO_VALIDATE=1
# Exotel (Indian caller ID; needs an Indian registered business + KYC)
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_APP_ID=
EXOTEL_SUBDOMAIN=api.exotel.com
# Sarvam Voice Agent – the AI check-in call (docs/COMMS.md section 5)
# API key from apps.sarvam.ai -> Settings -> API Key (falls back to SARVAM_API_KEY if empty)
SARVAM_AGENT_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
# The agent's app_id and published version
SARVAM_AGENT_ID=
SARVAM_AGENT_VERSION=1
# Deploy -> Phone Numbers: the connection id and the agent's number (E.164, e.g. +918045XXXXXX)
SARVAM_CONNECTION_ID=
SARVAM_AGENT_NUMBER=
# Any long random text; put into the webhook URL as ?token=... (Sarvam documents no signature)
SARVAM_WEBHOOK_SECRET=
# Number the agent tells the patient to call back (default: NURSE_DESK_PHONE)
SARVAM_CALLBACK_NUMBER=
SARVAM_AGENT_API_BASE=https://apps.sarvam.ai/api/outbounds
# Demo routing: real calls/messages only ever go to consenting TEAM phones (never fake patients)
DEMO_PATIENT_PHONE=
DEMO_GUARDIAN_PHONE=
DEMO_NURSE_PHONE=
# Nurse desk number for "press 3" transfers and click-to-call
NURSE_DESK_PHONE=
# Quiet hours (IST), default 21:00-07:00; per patient and per guardian in the app
QUIET_HOURS=21:00-07:00
# Background ladder ticker, automatic ladders after missed sessions, weekly consent question (1/0)
COMMS_TICKER=1
COMMS_AUTO_ESCALATE=1
COMMS_CONSENT_RENEWAL=1
