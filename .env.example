# Copy this file to .env and fill in what you have. Everything is optional: the app falls back safely.
DEMO_MODE=1
DATA_BACKEND=demo
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TZ_NAME=Asia/Kolkata
ANTHROPIC_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
DEMO_FAMILY_WHATSAPP=whatsapp:+91XXXXXXXXXX
DEMO_NURSE_WHATSAPP=whatsapp:+91XXXXXXXXXX
SARVAM_API_KEY=
# Voice (Sarvam AI) - see docs/VOICE.md. Only SARVAM_API_KEY is needed; the rest have good defaults.
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=
VOICE_GENDER=female
SARVAM_TTS_PACE=0.9
SARVAM_TTS_CODEC=mp3
SARVAM_STT_MODEL=saaras:v4
SARVAM_TRANSLATE_MODEL=mayura:v1
SARVAM_TIMEOUT_S=25
# Public address of this server (e.g. https://spirobuddy.onrender.com) so WhatsApp/Twilio can fetch voice notes
PUBLIC_BASE_URL=
PORT=8000
